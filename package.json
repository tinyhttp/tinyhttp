{
  "name": "@tinyhttp/monorepo",
  "version": "0.0.1",
  "private": true,
  "repository": "https://github.com/tinyhttp/tinyhttp.git",
  "author": {
    "name": "v1rtl",
    "email": "yo@v1rtl.site"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=14.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.7",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "^5.0.5",
    "c8": "^12.0.0",
    "eta": "2.2.0",
    "header-range-parser": "catalog:",
    "husky": "9.1.7",
    "regexparam": "catalog:",
    "supertest-fetch": "2.0.0",
    "typescript": "~7.0.2",
    "vitest": "5.0.5"
  },
  "scripts": {
    "prerelease": "pnpm lint && pnpm build && pnpm test",
    "chgset:run": "changeset",
    "chgset:version": "changeset version && pnpm install && biome check . --write",
    "chgset": "pnpm chgset:run && pnpm chgset:version",
    "release": "pnpm -r stage publish --access public --provenance --no-git-checks && changeset git-tag",
    "test:dev": "vitest --dir tests",
    "test:coverage": "vitest run --dir tests --coverage",
    "test": "pnpm test:coverage",
    "lint": "biome lint .",
    "format": "biome format .",
    "check": "biome check .",
    "echo:ancestor": "echo ${ANCESTOR_REF:-$(git merge-base origin/master HEAD)}",
    "build": "pnpm -r build",
    "prepare": "husky"
  },
  "packageManager": "pnpm@12.14.0"
}
